<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Open_script" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:colorAccent">#F34D4D</item>
    </style>
    <style name="Theme.Open_script.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F172A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Open_script</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0F172A</item>
    </style>
</resources>
