# Copie para .env e preencha com os dados do seu serviço.
DJANGO_DEBUG=true
OPENSCRIPT_API_TOKEN_DAYS=30
OPENSCRIPT_PUBLIC_URL=https://prefix-jalapeno-footboard.ngrok-free.dev

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Cliente OAuth do tipo Aplicação Web no Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OPENSCRIPT_LEGAL_RESPONSIBLE=
OPENSCRIPT_PRIVACY_EMAIL=
